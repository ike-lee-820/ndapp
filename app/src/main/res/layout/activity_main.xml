<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="服务器设置"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>
        <EditText
            android:id="@+id/etWorkerUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Worker URL（如 https://xxx.workers.dev）"
            android:inputType="textUri"
            android:autofillHints="url"/>
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="网盘密码"
            android:inputType="textPassword"
            android:autofillHints="password"/>
        <EditText
            android:id="@+id/etBaseFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="上传到目录（可留空，如 movies）"
            android:inputType="text"/>
        <Button
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="保存设置"
            android:layout_marginTop="8dp"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginVertical="16dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="选择文件"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnPickFiles"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="选择文件"/>
            <Button
                android:id="@+id/btnPickFolder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="选择文件夹"/>
        </LinearLayout>
        <TextView
            android:id="@+id/tvQueueInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="待上传: 0 个文件，总大小 0 B"
            android:layout_marginTop="12dp"
            android:textColor="#666666"
            android:textSize="14sp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">
            <Button
                android:id="@+id/btnClear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="清空"/>
            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:backgroundTint="#1976D2"
                android:textColor="#FFFFFF"
                android:text="开始后台上传"/>
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textSize="12sp"
            android:textColor="#888888"
            android:text="说明：\n• 上传在后台运行，可退出应用\n• 客户端直传 GitHub（不走 Worker 中转）\n• 每个文件独立任务，失败自动重试\n• 文件夹会递归上传并保留目录结构"/>
    </LinearLayout>
</ScrollView>
